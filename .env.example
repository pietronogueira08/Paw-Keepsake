# ============================================
# PAW & KEEPSAKE — Environment Variables
# ============================================
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All others are server-only.

# -- Stripe Payments ----------------------------------------------------------
# Server-only restricted or secret key (rk_live_... or sk_live_...)
STRIPE_SECRET_KEY=rk_live_...
# Client-accessible publishable key (pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook signing secret from Stripe Dashboard -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# -- Printify (Fulfillment) ---------------------------------------------------
PRINTIFY_API_TOKEN=...
PRINTIFY_SHOP_ID=28881871
PRINTIFY_CANVAS_PRODUCT_ID=6aa481666de8ba75bb0c008d
PRINTIFY_TSHIRT_PRODUCT_ID=6aa4834fd72c2d45ea019c86
PRINTIFY_MUG_PRODUCT_ID=6aa99b44ead8310cb609f28b

# -- Cloudflare R2 ------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=paw-keepsake-prints
R2_PUBLIC_URL=https://cdn.pawandkeepsake.com

# -- Analytics ----------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-...

# -- AI / Content Generation --------------------------------------------------
GEMINI_API_KEY=...

# -- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=re_...
FROM_EMAIL=pawkeepsake@gmail.com

# -- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://pawandkeepsake.com
