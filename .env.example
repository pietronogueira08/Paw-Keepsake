# ============================================
# PAW & KEEPSAKE — Environment Variables
# ============================================
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All others are server-only.


# -- Stripe -------------------------------------------------------------------
# Use test keys (sk_test_ / pk_test_) for local development.
# Switch to live keys only in production.

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secret — obtain from `stripe listen` CLI or the Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
# Create these in the Stripe Dashboard -> Products -> Add Product.
# Use recurring or one-time prices as appropriate.
STRIPE_PRICE_CANVAS_8X10=price_...
STRIPE_PRICE_CANVAS_12X16=price_...
STRIPE_PRICE_CANVAS_18X24=price_...
STRIPE_PRICE_CANVAS_24X36=price_...
STRIPE_PRICE_PRINT_8X10=price_...
STRIPE_PRICE_PRINT_12X16=price_...
STRIPE_PRICE_PRINT_18X24=price_...
STRIPE_PRICE_PRINT_24X36=price_...
STRIPE_PRICE_TSHIRT=price_...


# -- Cloudflare R2 ------------------------------------------------------------
# Create an R2 bucket and an API token in the Cloudflare dashboard.
# The token needs "Object Read & Write" permissions on the bucket.

CLOUDFLARE_R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=paw-keepsake-prints

# Public CDN URL for the R2 bucket (set up a custom domain in Cloudflare)
R2_PUBLIC_URL=https://cdn.pawandkeepsake.com


# -- Analytics ----------------------------------------------------------------
# Meta Pixel: found in Events Manager -> Data Sources -> your pixel
NEXT_PUBLIC_META_PIXEL_ID=...

# Google Analytics 4: found in Admin -> Data Streams -> your stream
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-...

# Meta Conversions API token (server-side events)
# Generate in: Events Manager -> your pixel -> Settings -> Conversions API
META_CAPI_ACCESS_TOKEN=...


# -- Email (Resend) -----------------------------------------------------------
# Sign up at https://resend.com and create an API key.
# Verify your sending domain before going to production.

RESEND_API_KEY=re_...
FROM_EMAIL=hello@pawandkeepsake.com


# -- App ----------------------------------------------------------------------
# Used for generating absolute URLs in emails, OG images, and sitemaps.

NEXT_PUBLIC_APP_URL=https://pawandkeepsake.com
